@using Linear.Domain.Sprints
@using Linear.Web.Features.Sprints.Contracts
@using Linear.Web.Features.Sprints.Create
@using Linear.Web.Features.Sprints.Update

@inject CreateSprintHandler CreateSprint
@inject UpdateSprintHandler UpdateSprint

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width: 420px;">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined">
                    @_error.Description
                </MudAlert>
            }

            <MudTextField @bind-Value="_name"
                          Label="Nombre"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          MaxLength="@Sprint.MaxNameLength"
                          Required="true"
                          AutoFocus="true" />

            <MudTextField @bind-Value="_goal"
                          Label="Objetivo"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="@Sprint.MaxGoalLength"
                          Lines="3"
                          HelperText="Qué se quiere lograr en este período." />

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                <MudDatePicker @bind-Date="_startDate"
                               Label="Inicio"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy" />
                <MudDatePicker @bind-Date="_endDate"
                               Label="Fin"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd/MM/yyyy" />
            </MudStack>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Size="Size.Small" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Size="Size.Small"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="_saving"
                   OnClick="SubmitAsync">
            @(Existing is null ? "Crear sprint" : "Guardar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public required string TeamKey { get; set; }

    /// <summary>Sprint a editar, o <c>null</c> para crear uno nuevo.</summary>
    [Parameter]
    public SprintSummaryResponse? Existing { get; set; }

    private string _name = string.Empty;
    private string? _goal;
    private DateTime? _startDate;
    private DateTime? _endDate;
    private Error? _error;
    private bool _saving;

    protected override void OnInitialized()
    {
        if (Existing is { } sprint)
        {
            _name = sprint.Name;
            _goal = sprint.Goal;
            _startDate = sprint.StartDate.ToDateTime(TimeOnly.MinValue);
            _endDate = sprint.EndDate.ToDateTime(TimeOnly.MinValue);
            return;
        }

        // Un sprint nuevo arranca hoy y dura dos semanas: es la duración más habitual, y
        // deja las dos fechas listas para aceptar sin tocarlas.
        var today = DateTime.Today;
        _startDate = today;
        _endDate = today.AddDays(14);
    }

    private async Task SubmitAsync()
    {
        if (_startDate is not { } start || _endDate is not { } end)
        {
            _error = SprintErrors.EndDateNotAfterStartDate;
            return;
        }

        _saving = true;
        _error = null;

        var startDate = DateOnly.FromDateTime(start);
        var endDate = DateOnly.FromDateTime(end);

        var result = Existing is { } existing
            ? await UpdateSprint.HandleAsync(
                new UpdateSprintRequest
                {
                    Key = TeamKey,
                    SprintId = existing.Id,
                    Name = _name,
                    Goal = _goal,
                    StartDate = startDate,
                    EndDate = endDate
                },
                CancellationToken.None)
            : await CreateSprint.HandleAsync(
                new CreateSprintRequest
                {
                    Key = TeamKey,
                    Name = _name,
                    Goal = _goal,
                    StartDate = startDate,
                    EndDate = endDate
                },
                CancellationToken.None);

        _saving = false;

        if (result.IsFailure)
        {
            _error = result.Error;
            return;
        }

        Dialog.Close(DialogResult.Ok(result.Value));
    }

    private void Cancel() => Dialog.Cancel();
}
