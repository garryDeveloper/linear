@using Linear.Web.Features.Teams.Contracts

@* Identidad del equipo al tope de cada una de sus páginas. Ya no dibuja qué sección está
   activa — eso lo resuelve AppSidebar con sus propios NavLink, para no repetir la misma
   navegación en dos lugares. Se muestra también mientras el equipo carga, para que la
   página no salte cuando llegan los datos. *@
<MudStack Spacing="1" Class="mb-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
            @(Team?.Key ?? TeamKey)
        </MudChip>
        <MudText Typo="Typo.h1">@(Team?.Name ?? "Equipo")</MudText>
    </MudStack>

    @if (!string.IsNullOrWhiteSpace(Team?.Description))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@Team.Description</MudText>
    }
</MudStack>

@code {
    [Parameter]
    public TeamResponse? Team { get; set; }

    /// <summary>Clave del equipo tomada de la ruta, disponible antes de que cargue.</summary>
    [Parameter]
    public string TeamKey { get; set; } = string.Empty;
}
