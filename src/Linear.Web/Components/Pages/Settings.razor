@page "/settings"
@using Linear.Web.Features.Diagnostics.Health
@implements IDisposable
@inject ThemeState ThemeState
@inject HealthHandler Health

<PageTitle>Configuración · Linear</PageTitle>

<MudStack Spacing="4">
    <div>
        <MudText Typo="Typo.h1">Configuración</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Preferencias de la aplicación.
        </MudText>
    </div>

    <MudPaper Outlined="true" Class="pa-4" Style="max-width: 520px;">
        <MudText Typo="Typo.h4" Class="mb-3">Apariencia</MudText>

        <MudSwitch T="bool"
                   Value="ThemeState.IsDarkMode"
                   ValueChanged="@((bool isDark) => ThemeState.SetDarkMode(isDark))"
                   Color="Color.Primary"
                   Label="Modo oscuro" />

        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Al iniciar sesión se usa la preferencia del sistema operativo.
        </MudText>
    </MudPaper>

    <MudPaper Outlined="true" Class="pa-4" Style="max-width: 520px;">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudText Typo="Typo.h4">Estado del sistema</MudText>
            <MudIconButton Icon="@Icons.Material.Rounded.Refresh"
                           Size="Size.Small"
                           aria-label="Volver a consultar el estado"
                           Disabled="_loading"
                           OnClick="LoadAsync" />
        </MudStack>

        @if (_loading)
        {
            <MudStack Spacing="2">
                <MudSkeleton Width="60%" />
                <MudSkeleton Width="45%" />
            </MudStack>
        }
        else if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined">
                @_error.Description
            </MudAlert>
        }
        else if (_health is not null)
        {
            <MudStack Spacing="2">
                <StatusRow Label="Aplicación"
                           Value="@_health.Status"
                           Healthy="@(_health.Status == HealthStatuses.Healthy)" />
                <StatusRow Label="Base de datos"
                           Value="@_health.Database"
                           Healthy="@(_health.Database == DatabaseStatuses.Connected)" />
                <StatusRow Label="Entorno" Value="@_health.Environment" Healthy="true" />
            </MudStack>

            @if (_health.Database != DatabaseStatuses.Connected)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mt-3">
                    PostgreSQL no responde. Levantá la base con <code>docker compose up -d</code>.
                </MudAlert>
            }
        }
    </MudPaper>
</MudStack>

@code {
    private readonly CancellationTokenSource _cancellation = new();

    private HealthResponse? _health;
    private Error? _error;
    private bool _loading = true;

    protected override void OnInitialized() => ThemeState.Changed += OnThemeChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Se consulta recién en el render interactivo: durante el prerender el resultado
        // se descartaría al establecerse el circuito y la consulta se haría dos veces.
        if (firstRender)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        var result = await Health.HandleAsync(_cancellation.Token);

        if (result.IsSuccess)
        {
            _health = result.Value;
        }
        else
        {
            _error = result.Error;
        }

        _loading = false;
        StateHasChanged();
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ThemeState.Changed -= OnThemeChanged;
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}
