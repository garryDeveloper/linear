@page "/"
@inject NavigationManager Navigation

@* La lista es la pantalla de inicio: no hay panel intermedio antes de ver con qué se
   trabaja. Equipos es hoy lo más cercano a esa lista — cuando exista Issues, este
   redirect pasa a apuntar ahí. El chequeo de salud que vivía acá se mudó a
   Configuración: es información para quien opera la instalación, no la puerta de
   entrada de quien la usa. *@
@code {
    protected override void OnInitialized() => Navigation.NavigateTo("/teams", replace: true);
}
