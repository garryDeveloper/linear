@implements IAsyncDisposable

@inject IDialogService DialogService
@inject IJSRuntime JS

@* Botón del buscador y dueño del atajo Ctrl/Cmd+K. Vive en la cabecera, que está presente
   en todas las pantallas: así el atajo funciona en cualquier lugar de la aplicación sin
   que cada página tenga que ocuparse. *@
<MudTooltip Text="Buscar issues (Ctrl+K)">
    <MudIconButton Icon="@Icons.Material.Rounded.Search"
                   Size="Size.Small"
                   aria-label="Buscar issues"
                   OnClick="OpenAsync" />
</MudTooltip>

@code {
    private DotNetObjectReference<SearchLauncher>? _reference;
    private IJSObjectReference? _module;
    private bool _open;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _reference = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./Components/Common/SearchLauncher.razor.js");

        await _module.InvokeVoidAsync("register", _reference);
    }

    /// <summary>
    /// Abre el buscador. Es pública y <c>JSInvokable</c> porque la llama el atajo de teclado
    /// desde el navegador, además del botón.
    /// </summary>
    /// <remarks>
    /// Si ya está abierto no hace nada. Sin esta guarda, volver a apretar Ctrl+K con el
    /// buscador en pantalla apila un segundo diálogo encima del primero.
    /// </remarks>
    [JSInvokable]
    public async Task OpenAsync()
    {
        if (_open)
        {
            return;
        }

        _open = true;

        try
        {
            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                CloseOnEscapeKey = true
            };

            var dialog = await DialogService.ShowAsync<SearchDialog>(title: null, options);

            await dialog.Result;
        }
        finally
        {
            _open = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unregister");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // El circuito ya se cerró: no queda navegador al que pedirle nada.
            }
        }

        _reference?.Dispose();
    }
}
