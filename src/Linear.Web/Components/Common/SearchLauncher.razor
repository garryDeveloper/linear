@inject SearchDialogLauncher Launcher

@* Botón del buscador en la cabecera.
   El atajo Ctrl/Cmd+K ya no se registra acá: lo maneja KeyboardShortcuts, que es el único
   componente que escucha el teclado (task 013). Los dos caminos terminan en el mismo
   SearchDialogLauncher, que es quien evita que se apilen dos diálogos. *@
<MudTooltip Text="Buscar issues (Ctrl+K)">
    <MudIconButton Icon="@Icons.Material.Rounded.Search"
                   Size="Size.Small"
                   aria-label="Buscar issues"
                   OnClick="Launcher.OpenAsync" />
</MudTooltip>
