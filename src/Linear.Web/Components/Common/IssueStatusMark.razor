@using Linear.Domain.Issues

@* Una marca, no una etiqueta de color: el mismo ícono identifica el mismo estado en la
   lista, el detalle y —cuando exista— el tablero de sprint. *@
<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="@Class">
    <MudIcon Icon="@IssueStatusLabel.IconFor(Status)"
             Color="@IssueStatusLabel.ColorFor(Status)"
             Size="Size.Small" />
    @if (ShowLabel)
    {
        <MudText Typo="Typo.body2">@IssueStatusLabel.For(Status)</MudText>
    }
</MudStack>

@code {
    [Parameter, EditorRequired]
    public required IssueStatus Status { get; set; }

    [Parameter]
    public bool ShowLabel { get; set; } = true;

    [Parameter]
    public string Class { get; set; } = string.Empty;
}
