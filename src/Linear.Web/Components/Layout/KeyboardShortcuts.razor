@implements IAsyncDisposable

@using Linear.Web.Features.Teams.Contracts
@using Linear.Web.Features.Teams.GetByKey
@using Linear.Web.Components.Pages.Teams

@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject SearchDialogLauncher SearchLauncherService
@inject GetTeamByKeyHandler GetTeam
@inject IJSRuntime JS

@* Motor central de atajos. No dibuja nada: vive en el layout para estar presente en todas
   las pantallas y ser el único que escucha el teclado, como pide la task 013. Ningún otro
   componente registra un listener global. *@

@code {
    private readonly CancellationTokenSource _cancellation = new();

    private DotNetObjectReference<KeyboardShortcuts>? _reference;
    private IJSObjectReference? _module;
    private bool _helpOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _reference = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./Components/Layout/KeyboardShortcuts.razor.js");

        // La tabla se manda desde acá: es la misma que muestra la ayuda.
        await _module.InvokeVoidAsync("register", _reference, AppShortcuts.Bindings);
    }

    /// <summary>
    /// Ejecuta el atajo que disparó el navegador.
    /// </summary>
    /// <remarks>
    /// Los de navegación necesitan un equipo, y fuera de un equipo no hay adónde ir: en esas
    /// pantallas simplemente no hacen nada, en vez de llevar a una ruta inventada.
    /// </remarks>
    [JSInvokable]
    public async Task HandleAsync(string id)
    {
        switch (id)
        {
            case AppShortcuts.Search:
                await SearchLauncherService.OpenAsync();
                break;

            case AppShortcuts.Help:
                await ShowHelpAsync();
                break;

            case AppShortcuts.CreateIssue:
                await CreateIssueAsync();
                break;

            case AppShortcuts.GoIssues:
                GoTo("issues");
                break;

            case AppShortcuts.GoSprints:
                GoTo("sprints");
                break;

            case AppShortcuts.GoRoadmap:
                GoTo("roadmaps");
                break;
        }
    }

    private string? CurrentTeamKey =>
        TeamRoute.KeyFrom(Navigation.ToBaseRelativePath(Navigation.Uri));

    private void GoTo(string section)
    {
        if (CurrentTeamKey is { } key)
        {
            Navigation.NavigateTo($"/teams/{key}/{section}");
        }
    }

    /// <summary>
    /// Abre el diálogo de nuevo issue desde cualquier pantalla del equipo.
    /// </summary>
    /// <remarks>
    /// El diálogo necesita el equipo cargado —ofrece sus miembros y sus labels—, así que acá
    /// se resuelve por la clave de la ruta. Es el precio de que el atajo funcione en todas
    /// las pantallas y no solo en el listado, que es donde vive el botón.
    /// </remarks>
    private async Task CreateIssueAsync()
    {
        if (CurrentTeamKey is not { } key)
        {
            return;
        }

        var team = await GetTeam.HandleAsync(key, _cancellation.Token);

        if (team.IsFailure)
        {
            return;
        }

        var parameters = new DialogParameters<CreateIssueDialog>
        {
            { dialog => dialog.Team, team.Value }
        };

        var dialog = await DialogService.ShowAsync<CreateIssueDialog>("Nuevo issue", parameters);

        if (await dialog.Result is { Canceled: false, Data: string identifier })
        {
            Navigation.NavigateTo($"/teams/{key}/issues/{identifier}");
        }
    }

    private async Task ShowHelpAsync()
    {
        // Misma guarda que el buscador: apretar "?" con la ayuda abierta no debe apilar otra.
        if (_helpOpen)
        {
            return;
        }

        _helpOpen = true;

        try
        {
            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.ExtraSmall,
                FullWidth = true,
                CloseOnEscapeKey = true
            };

            var dialog = await DialogService.ShowAsync<ShortcutHelpDialog>("Atajos de teclado", options);

            await dialog.Result;
        }
        finally
        {
            _helpOpen = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cancellation.Cancel();
        _cancellation.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unregister");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // El circuito ya se cerró: no queda navegador al que pedirle nada.
            }
        }

        _reference?.Dispose();
    }
}
