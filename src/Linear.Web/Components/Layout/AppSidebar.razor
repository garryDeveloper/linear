@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* Nunca dos niveles de navegación a la vez: dentro de un equipo, la barra lateral
   muestra sus secciones (Issues, Sprints, Roadmap, Actividad, Miembros, Labels, Configuración)
   Equipos/Configuración generales — TeamPageHeader dejó de dibujarlas como pestañas.
   Todas las secciones del equipo cuelgan de acá.

   La variante depende del ancho. Fija empuja al contenido, que es lo que se quiere en una
   pantalla grande; en un teléfono esa misma barra ocupa más de la mitad del ancho y deja al
   contenido sin lugar —el listado de issues no entraba y la página entera scrolleaba de
   costado—, así que ahí se superpone y se cierra sola. *@
<MudDrawer Open="Open"
           OpenChanged="OpenChanged"
           Elevation="0"
           Variant="@(_narrow ? DrawerVariant.Temporary : DrawerVariant.Persistent)"
           ClipMode="DrawerClipMode.Always"
           Class="border-r">
    <MudNavMenu Dense="true" Class="pt-2">
        @if (_teamKey is { } key)
        {
            <MudNavLink Href="@($"/teams/{key}/issues")"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Rounded.List">
                Issues
            </MudNavLink>
            <MudNavLink Href="@($"/teams/{key}/sprints")"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Rounded.DateRange">
                Sprints
            </MudNavLink>
            <MudNavLink Href="@($"/teams/{key}/roadmaps")"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Rounded.Timeline">
                Roadmap
            </MudNavLink>
            <MudNavLink Href="@($"/teams/{key}/activity")"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Rounded.History">
                Actividad
            </MudNavLink>
            <MudNavLink Href="@($"/teams/{key}/members")"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Rounded.Group">
                Miembros
            </MudNavLink>
            <MudNavLink Href="@($"/teams/{key}/labels")"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Rounded.Label">
                Labels
            </MudNavLink>
            <MudNavLink Href="@($"/teams/{key}/settings")"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Rounded.Settings">
                Configuración
            </MudNavLink>
        }
        else
        {
            <MudNavLink Href="/teams"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Rounded.Groups">
                Equipos
            </MudNavLink>
            <MudNavLink Href="/settings"
                        Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Rounded.Settings">
                Configuración
            </MudNavLink>
        }
    </MudNavMenu>
</MudDrawer>

@code {
    /// <summary>Indica si la navegación lateral está expandida.</summary>
    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>
    /// Ancho máximo, en píxeles, con el que la barra se superpone en vez de empujar.
    /// </summary>
    /// <remarks>
    /// Es el punto de corte Md de MudBlazor, el mismo que usa la regla de app.css que anula
    /// el lugar reservado para la barra. Si se cambia uno hay que cambiar el otro.
    /// </remarks>
    private const int NarrowMaxWidth = 959;

    /// <summary>Si la pantalla es angosta —un teléfono— y la barra tiene que superponerse.</summary>
    private bool _narrow;

    private IJSObjectReference? _module;
    private DotNetObjectReference<AppSidebar>? _reference;

    private string? _teamKey;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        UpdateTeamKey();
    }

    /// <summary>
    /// Averigua de qué tamaño es la pantalla, que solo se sabe desde el navegador.
    /// </summary>
    /// <remarks>
    /// El ancho decide si la barra empuja al contenido o se le superpone, y por eso se
    /// resuelve acá y no con <c>DrawerVariant.Responsive</c>: esa variante maneja por su
    /// cuenta el estado de apertura y pelea con el <c>Open</c> enlazado que necesita el botón
    /// de la cabecera —la barra quedaba cerrada en escritorio y no volvía a abrirse—.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./Components/Layout/AppSidebar.razor.js");

        _reference = DotNetObjectReference.Create(this);

        await _module.InvokeVoidAsync("observe", _reference, NarrowMaxWidth);

        await ApplyWidthAsync(await _module.InvokeAsync<bool>("isNarrow", NarrowMaxWidth));
    }

    /// <summary>Lo llama JavaScript cuando la ventana cruza el límite.</summary>
    [JSInvokable]
    public Task OnWidthChangedAsync(bool narrow) => InvokeAsync(() => ApplyWidthAsync(narrow));

    private async Task ApplyWidthAsync(bool narrow)
    {
        if (narrow == _narrow)
        {
            return;
        }

        _narrow = narrow;

        // En una pantalla angosta arranca cerrada: abierta ocupa más de la mitad del ancho y
        // deja al contenido sin lugar. El botón de la cabecera la muestra cuando hace falta.
        // Al volver a una pantalla grande se reabre, que es como estaba antes de achicarla.
        await OpenChanged.InvokeAsync(!narrow);

        StateHasChanged();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        UpdateTeamKey();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateTeamKey() =>
        _teamKey = TeamRoute.KeyFrom(Navigation.ToBaseRelativePath(Navigation.Uri));

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unobserve");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // El circuito ya se cerró: no queda navegador al que pedirle nada.
            }
        }

        _reference?.Dispose();
    }
}
