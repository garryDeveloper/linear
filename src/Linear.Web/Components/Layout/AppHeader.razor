@inject ThemeState ThemeState

<MudAppBar Elevation="0" Dense="true" Class="border-b">
    <MudIconButton Icon="@Icons.Material.Rounded.Menu"
                   Size="Size.Small"
                   Edge="Edge.Start"
                   aria-label="Mostrar u ocultar la navegación"
                   OnClick="OnToggleSidebar" />

    <MudText Typo="Typo.h6" Class="ml-2">Linear</MudText>

    <MudSpacer />

    <MudTooltip Text="@(ThemeState.IsDarkMode ? "Cambiar a modo claro" : "Cambiar a modo oscuro")">
        <MudIconButton Icon="@(ThemeState.IsDarkMode ? Icons.Material.Rounded.LightMode : Icons.Material.Rounded.DarkMode)"
                       Size="Size.Small"
                       aria-label="Cambiar el tema de la interfaz"
                       OnClick="@(() => ThemeState.Toggle())" />
    </MudTooltip>

    <AuthorizeView Context="auth">
        <Authorized>
            @* El activador es propio, así que tiene que abrir el menú a través del
               MenuContext: MudMenu no cablea el clic de un ActivatorContent. *@
            <MudMenu AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight"
                     Class="ml-2"
                     AriaLabel="Menú del usuario">
                <ActivatorContent Context="menu">
                    <MudIconButton Size="Size.Small"
                                   aria-label="Menú del usuario"
                                   OnClick="@(() => menu.ToggleAsync())">
                        <UserAvatar Name="@auth.User.GetName()" AvatarUrl="@auth.User.GetAvatarUrl()" />
                    </MudIconButton>
                </ActivatorContent>
                <ChildContent>
                    <div class="px-4 py-2">
                        <MudText Typo="Typo.body2">@auth.User.GetName()</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @auth.User.GetEmail()
                        </MudText>
                    </div>
                    <MudDivider />
                    <MudMenuItem Href="/account/profile" Icon="@Icons.Material.Rounded.Person">
                        Perfil
                    </MudMenuItem>
                    <MudMenuItem Href="/account/logout" Icon="@Icons.Material.Rounded.Logout">
                        Cerrar sesión
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        </Authorized>
    </AuthorizeView>
</MudAppBar>

@code {
    /// <summary>Se invoca cuando el usuario pide mostrar u ocultar la navegación lateral.</summary>
    [Parameter]
    public EventCallback OnToggleSidebar { get; set; }
}
