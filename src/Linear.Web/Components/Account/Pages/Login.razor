@page "/account/login"
@layout AccountLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

@using System.ComponentModel.DataAnnotations
@using Linear.Web.Features.Authentication.Login
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies

@inject LoginHandler LoginHandler
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión · Linear</PageTitle>

<MudPaper Outlined="true" Class="pa-6">
    <MudText Typo="Typo.h2" Class="mb-1">Linear</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-5">
        Iniciá sesión para continuar.
    </MudText>

    <EditForm Model="Input" FormName="login" OnValidSubmit="LogInAsync" method="post">
        <DataAnnotationsValidator />

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined" Class="mb-4">
                @_error
            </MudAlert>
        }

        <div class="field">
            <label class="field-label" for="email">Email</label>
            <InputText id="email"
                       class="field-input"
                       autocomplete="username"
                       type="email"
                       @bind-Value="Input.Email" />
            <ValidationMessage For="() => Input.Email" />
        </div>

        <div class="field">
            <label class="field-label" for="password">Contraseña</label>
            <InputText id="password"
                       class="field-input"
                       autocomplete="current-password"
                       type="password"
                       @bind-Value="Input.Password" />
            <ValidationMessage For="() => Input.Password" />
        </div>

        <div class="field field-inline">
            <InputCheckbox id="rememberMe" @bind-Value="Input.RememberMe" />
            <label for="rememberMe">Mantener la sesión iniciada</label>
        </div>

        <MudButton ButtonType="ButtonType.Submit"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   Class="mt-2">
            Iniciar sesión
        </MudButton>
    </EditForm>
</MudPaper>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? _error;

    protected override void OnInitialized()
    {
        // El binding del formulario reemplaza esta propiedad en cada POST, así que se
        // inicializa acá y no en la declaración: un inicializador quedaría pisado por null.
        Input ??= new LoginInput();

        if (HttpContext.User.IsAuthenticated())
        {
            Navigation.NavigateTo(SafeReturnUrl());
        }
    }

    private async Task LogInAsync()
    {
        var result = await LoginHandler.HandleAsync(Input.Email, Input.Password, HttpContext.RequestAborted);

        if (result.IsFailure)
        {
            _error = result.Error.Description;
            return;
        }

        var principal = UserClaims.CreatePrincipal(result.Value, CookieAuthenticationDefaults.AuthenticationScheme);

        var properties = new AuthenticationProperties
        {
            IsPersistent = Input.RememberMe,
            ExpiresUtc = Input.RememberMe
                ? DateTimeOffset.UtcNow.Add(AppAuthenticationExtensions.PersistentSessionLifetime)
                : null
        };

        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal, properties);

        Navigation.NavigateTo(SafeReturnUrl());
    }

    /// <summary>
    /// Destino tras iniciar sesión, restringido a rutas de esta aplicación.
    /// </summary>
    /// <remarks>
    /// Sin esta comprobación, un enlace con <c>?returnUrl=https://otro-sitio</c> convertiría
    /// la pantalla de login en un redirector abierto hacia una copia falsa del sitio.
    /// </remarks>
    private string SafeReturnUrl()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl))
        {
            return "/";
        }

        var isLocal = ReturnUrl.StartsWith('/') &&
                      !ReturnUrl.StartsWith("//", StringComparison.Ordinal) &&
                      !ReturnUrl.StartsWith("/\\", StringComparison.Ordinal);

        return isLocal ? ReturnUrl : "/";
    }

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "El email es obligatorio.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "La contraseña es obligatoria.")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}
