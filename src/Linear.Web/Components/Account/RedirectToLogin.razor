@inject NavigationManager Navigation

@code {
    /// <summary>
    /// Envía a la pantalla de inicio de sesión conservando el destino original.
    /// </summary>
    /// <remarks>
    /// La política de respaldo ya rechaza a los usuarios sin sesión en el nivel HTTP; esto
    /// cubre el caso en que la sesión vence mientras el circuito sigue abierto y la
    /// navegación ocurre del lado del cliente.
    /// </remarks>
    protected override void OnInitialized()
    {
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);

        Navigation.NavigateTo($"/account/login?returnUrl=/{Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
